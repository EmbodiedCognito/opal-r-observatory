{
  "name": "opal-r-observatory",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-webr.mjs && vite",
    "server": "node server/index.mjs",
    "local": "npm run build && npm run server",
    "build": "node scripts/copy-webr.mjs && tsc -b && vite build",
